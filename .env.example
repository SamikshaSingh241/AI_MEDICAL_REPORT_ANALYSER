# ==============================================================================
# Environment Configuration Template for Docker & Cloud Deployments
# ==============================================================================

# Gemini AI API Key (Required for medical report parsing)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret Key
JWT_SECRET=super_secure_enterprise_cloud_jwt_secret_change_me_in_prod

# MongoDB Root Credentials
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=medisense

# Node Environment
NODE_ENV=production
